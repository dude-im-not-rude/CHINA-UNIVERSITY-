# Neon Postgres connection string (server-only; never expose as NEXT_PUBLIC_)
DATABASE_URL=

# Web3Forms access key (public by design)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Admin authentication (server-only)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional: base32 TOTP secret for 2FA
ADMIN_TOTP_SECRET=
